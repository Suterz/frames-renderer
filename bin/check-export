#!/usr/bin/env python3
"""Decode actual MP4 video frames around cuts; inspect PNGs, not just metadata."""
import json, subprocess, sys
from pathlib import Path
from PIL import Image, ImageChops, ImageStat

job=Path(sys.argv[1]).resolve()
manifest=json.loads((job/"manifest.json").read_text())
video=job/"video.mp4"
if not video.exists():raise SystemExit("no verified video.mp4")
ff=str(Path.home()/"ai/tools/media/bin/ffmpeg")
out=job/"verification";out.mkdir(exist_ok=True)
ends=manifest["verification"]["expected_video_frames"]
frames={0,ends-1}
for item in manifest["timeline"]:
    if item["start_frame"]>0:
        frames.update((item["start_frame"]-1,item["start_frame"]))
for n in sorted(frames):
    target=out/f"decoded-{n:04d}.png"
    subprocess.run([ff,"-hide_banner","-loglevel","error","-y","-i",str(video),
                    "-vf",f"select=eq(n\\,{n})","-fps_mode","passthrough","-frames:v","1",str(target)],
                   check=True,timeout=90)
    with Image.open(target) as im:
        if im.size!=(1080,1920):raise ValueError(f"wrong dimensions at frame {n}: {im.size}")
results=[]
for entry in manifest["timeline"]:
    b=entry["start_frame"]
    if b<=0:continue
    with Image.open(out/f"decoded-{b-1:04d}.png") as before,Image.open(out/f"decoded-{b:04d}.png") as after:
        difference=ImageChops.difference(before.convert("RGB"),after.convert("RGB"))
        st=ImageStat.Stat(difference)
    results.append({"cue":entry["cue"],"boundary_frame":b,"mean_rgb_absolute_change":round(sum(st.mean)/3,4),
                    "note":"lossy MP4 comparison; exact pixel equality is tested on source composites"})
print(json.dumps({"frame_count":ends,"decoded":sorted(frames),"boundaries":results},indent=2))
(out/"cuts.json").write_text(json.dumps(results,indent=2))
