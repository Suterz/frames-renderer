#!/usr/bin/env python3
"""Exercise a clean edit and explicit cross-session rejection."""
import json
from pathlib import Path

import httpx

with httpx.Client(base_url="http://127.0.0.1:8788", timeout=30) as h:
    clean = Path.home() / "Videos/storyboard-renderer/demo/clean/P01.png"
    r = h.post("/v2/assets", files={"image": ("style.png", clean.read_bytes(), "image/png")})
    r.raise_for_status()
    asset = r.json()["asset_id"]
    sessions = []
    for text, refs in [
        ("Rounded editorial cartoon on warm ivory, dark plum ink, teal accents and warm ochre; simple face and thick strokes.", [asset]),
        ("Flat cut-paper silhouette collage on a cobalt blue sheet, coral and electric lime clothes; geometric nose, no purple or beige.", []),
    ]:
        r = h.post("/v2/sessions", json={"story_context": "An orange merchant wonders about a price tag.",
                                       "visual_signature": text, "style_ref_ids": refs})
        r.raise_for_status()
        sessions.append(r.json()["session_id"])
    opener = {"key": "opening", "op": "new_scene", "scene_id": "shop", "objective": "Recognize a curious merchant and one bag.",
              "instruction": "One cartoon woman in a market, standing centered behind one brown paper grocery bag. Both hands hold the bag still. Plain blank background.",
              "seed": 31}
    result = []
    for sid in sessions:
        r = h.post(f"/v2/sessions/{sid}/panels", json=opener)
        r.raise_for_status()
        result.append(r.json())
    r = h.post(f"/v2/sessions/{sessions[1]}/panels", json={**opener, "key": "cross", "op": "edit_scene",
                "parent_panel_id": result[0]["panel_id"]})
    assert r.status_code == 404, r.text
    print(json.dumps({"sessions": sessions, "openings": result, "cross_session_status": r.status_code}))
