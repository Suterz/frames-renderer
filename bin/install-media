#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/ai/tools/bin"
if [ ! -x "$HOME/ai/tools/bin/micromamba" ]; then
  curl -fLsS --retry 3 https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xj -C "$HOME/ai/tools" bin/micromamba
fi
if [ ! -x "$HOME/ai/tools/media/bin/ffmpeg" ]; then
  "$HOME/ai/tools/bin/micromamba" create -y -p "$HOME/ai/tools/media" -c conda-forge 'ffmpeg=9.*=*gpl*'
fi
"$HOME/ai/tools/media/bin/ffmpeg" -hide_banner -encoders | grep libx264
"$HOME/ai/tools/media/bin/ffprobe" -version | head -1
