#!/usr/bin/env bash
# External reusable local illustration tools: never install into this Git checkout.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
export HF_HOME="$HOME/ai/hf-cache"
mkdir -p "$HOME/ai/models/hidream" "$HOME/ai/models/flux" "$HOME/venvs"
if [ ! -d "$HOME/ai/ComfyUI/.git" ]; then
  git clone --depth 1 --branch v0.46.0 https://github.com/Comfy-Org/ComfyUI.git "$HOME/ai/ComfyUI"
fi
if [ ! -x "$HOME/venvs/comfy-storyboard/bin/python" ]; then
  uv venv "$HOME/venvs/comfy-storyboard" --python /usr/bin/python3
fi
uv pip install --python "$HOME/venvs/comfy-storyboard/bin/python" torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu130/
uv pip install --python "$HOME/venvs/comfy-storyboard/bin/python" -r "$HOME/ai/ComfyUI/requirements.txt" huggingface_hub hf_xet
"$HOME/venvs/comfy-storyboard/bin/python" -c 'import torch; assert torch.cuda.is_available(); print(torch.__version__, torch.cuda.get_device_name(0))'
mkdir -p "$HOME/ai/ComfyUI/models"/{checkpoints,diffusion_models,text_encoders,vae}
hf="$HOME/venvs/comfy-storyboard/bin/hf"
"$hf" download Comfy-Org/HiDream-O1-Image checkpoints/hidream_o1_image_bf16.safetensors --revision 7b75f4cd7e757d55d9bd1d30fb40375fb446f38c --local-dir "$HOME/ai/models/hidream"
ln -sfn "$HOME/ai/models/hidream/checkpoints/hidream_o1_image_bf16.safetensors" "$HOME/ai/ComfyUI/models/checkpoints/hidream_o1_image_bf16.safetensors"
"$hf" download black-forest-labs/FLUX.2-klein-4B flux-2-klein-4b.safetensors --revision e7b7dc27f91deacad38e78976d1f2b499d76a294 --local-dir "$HOME/ai/models/flux"
ln -sfn "$HOME/ai/models/flux/flux-2-klein-4b.safetensors" "$HOME/ai/ComfyUI/models/diffusion_models/flux-2-klein-4b.safetensors"
"$hf" download Comfy-Org/flux2-klein-4B split_files/text_encoders/qwen_3_4b.safetensors split_files/vae/flux2-vae.safetensors --revision 5b3abca5c0dc1ecd4eaf3340868d09063fc1c965 --local-dir "$HOME/ai/models/flux"
ln -sfn "$HOME/ai/models/flux/split_files/text_encoders/qwen_3_4b.safetensors" "$HOME/ai/ComfyUI/models/text_encoders/qwen_3_4b.safetensors"
ln -sfn "$HOME/ai/models/flux/split_files/vae/flux2-vae.safetensors" "$HOME/ai/ComfyUI/models/vae/flux2-vae.safetensors"
echo "External backend ready; start with ./bin/start-backend"
