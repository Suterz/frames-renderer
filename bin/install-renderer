#!/usr/bin/env bash
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
cd "$(dirname "$0")/.."
if [ ! -x "$HOME/venvs/frames-renderer/bin/python" ]; then
  uv venv "$HOME/venvs/frames-renderer" --python /usr/bin/python3
fi
uv pip install --python "$HOME/venvs/frames-renderer/bin/python" '.[test]'
echo "Frame renderer installed in isolated venv; ./bin/start-frame-renderer"
